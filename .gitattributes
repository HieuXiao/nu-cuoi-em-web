# Normalize line endings: LF in the repo, auto on checkout
* text=auto eol=lf

# Shell / config always LF (run on the Linux VPS)
*.sh        text eol=lf
*.conf      text eol=lf
*.service   text eol=lf
*.timer     text eol=lf
Makefile    text eol=lf

# Windows scripts always CRLF
*.bat       text eol=crlf
*.cmd       text eol=crlf

# Binary — never touch
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.webp      binary
*.pdf       binary
*.docx      binary
*.woff      binary
*.woff2     binary
